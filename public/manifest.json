{
  "manifest_version": 3,
  "name": "IVAC Automation",
  "version": "1.0.0",

  "icons": {
    "16": "icons/process-16.png",
    "32": "icons/process-32.png",
    "48": "icons/process-48.png",
    "128": "icons/process-128.png"
  },

  "permissions": ["storage", "activeTab", "scripting", "tabs", "windows"],

  "host_permissions": [
    "https://appointment.ivacbd.com/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseapp.com/*",
    "https://*.firebasestorage.app/*"
  ],

  "action": {
    "default_title": "IVAC Automation",
    "default_icon": {
      "16": "icons/process-16.png",
      "32": "icons/process-32.png",
      "48": "icons/process-48.png",
      "128": "icons/process-128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://appointment.ivacbd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

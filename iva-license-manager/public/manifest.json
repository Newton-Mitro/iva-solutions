{
  "manifest_version": 3,
  "name": "IVAC License Manager",
  "version": "1.0.0",
  "description": "Firebase-backed IVAC license manager.",
  "action": {
    "default_title": "IVAC License Manager",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}